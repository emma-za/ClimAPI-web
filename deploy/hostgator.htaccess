# Climapi - configuracion para Apache (HostGator / cPanel).
# En el zip se incluye como ".htaccess" en la raiz del sitio. Cada bloque va en <IfModule>:
# si el servidor no tiene ese modulo, simplemente se ignora (no provoca error 500).

# --- Tipos de archivo y codificacion ---
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js
  AddDefaultCharset UTF-8
</IfModule>

# --- Compresion (el sitio carga unos 30 archivos de texto) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# --- Cache en el navegador ---
# El HTML no se guarda (asi las versiones nuevas se ven al instante); los CSS/JS llevan "?v=N" en
# index.html, por lo que al subir cambios basta con subir ese numero para saltarse la cache.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType application/manifest+json "access plus 1 day"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>

# --- Forzar HTTPS (opcional) ---
# Recomendado: copiar el enlace compartido, el portapapeles de la postal y la instalacion en el movil
# solo funcionan en HTTPS. Descomenta estas lineas CUANDO el certificado SSL ya este activo
# (cPanel > SSL/TLS Status > Run AutoSSL); si lo activas antes, el sitio dejara de abrir.
#
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} off
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
